# =================================================================
# RAKSHAK (रक्षक) — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your real keys.
# =================================================================

# 1. Primary LLM Provider (Groq API) - REQUIRED FOR LLM ADVISORY
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Weather Provider (OPTIONAL)
# By default, Rakshak uses Open-Meteo which is FREE and requires NO API KEY.
# If you prefer OpenWeatherMap or WeatherAPI, you can optionally provide their keys:
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=

# 3. Database Configuration
# Local SQLite default (out-of-the-box) or PostgreSQL for production:
DATABASE_URL=sqlite:///./rakshak.db

# 4. Plant Coordinates (Default: MRPL Mangalore Refinery)
DEFAULT_LAT=12.9904
DEFAULT_LON=74.8219

# 5. Statutory Regulatory Thresholds (PPM / PPM·hr)
TIER1_TWA_MAX=1.0
TIER1_7DAY_MAX=15.0
TIER2_TWA_MAX=5.0
TIER2_7DAY_MAX=35.0
SINGLE_SHIFT_CRITICAL_DOSE=20.0
RAG_CONFIDENCE_THRESHOLD=0.85
